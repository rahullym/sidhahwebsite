---
import Base from '../../layouts/Base.astro';
import { getPosts } from '../../lib/server/content';
import { formatDate } from '../../lib/format';
import { href } from '../../lib/url';

const posts = await getPosts();
---

<Base
  title="Blog"
  description="News, career advice and hospital administration insights from Sidhah Edutech, Kochi."
>
  <section class="hex-pattern border-b border-ink-100 bg-brand-50/60">
    <div class="container-page py-16 sm:py-20">
      <p class="text-xs font-bold uppercase tracking-[0.18em] text-brand-700">Blog</p>
      <h1 class="mt-3 max-w-3xl text-4xl leading-tight sm:text-5xl">News &amp; career advice</h1>
      <p class="mt-5 max-w-2xl text-lg leading-relaxed text-ink-600">
        What is happening at Sidhah, and what we tell students about working in hospitals.
      </p>
    </div>
  </section>

  <section class="container-page py-16 sm:py-20">
    {
      posts.length === 0 ? (
        <p class="text-center text-ink-400">No posts yet — check back soon.</p>
      ) : (
        <ul class="grid gap-8 sm:grid-cols-2 lg:grid-cols-3">
          {posts.map((post) => (
            <li class="group relative flex flex-col overflow-hidden rounded-3xl border border-ink-100 bg-white shadow-card transition-shadow hover:shadow-lift">
              <div class="aspect-16/9 overflow-hidden bg-brand-50">
                {post.cover && (
                  <img src={post.cover} alt="" loading="lazy" class="h-full w-full object-cover transition-transform duration-500 motion-safe:group-hover:scale-105" />
                )}
              </div>
              <div class="flex flex-1 flex-col p-6">
                {post.published_at && (
                  <p class="text-xs font-bold uppercase tracking-[0.14em] text-ink-400">{formatDate(post.published_at)}</p>
                )}
                <h2 class="mt-2 text-xl leading-snug">
                  <a href={href(`/blog/${post.slug}/`)} class="after:absolute after:inset-0">{post.title}</a>
                </h2>
                {post.excerpt && <p class="mt-3 text-[0.95rem] leading-relaxed text-ink-600">{post.excerpt}</p>}
              </div>
            </li>
          ))}
        </ul>
      )
    }
  </section>
</Base>
