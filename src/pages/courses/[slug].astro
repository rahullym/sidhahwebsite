---
import Base from '../../layouts/Base.astro';
import SyllabusAccordion from '../../components/SyllabusAccordion.astro';
import EnquiryCTA from '../../components/EnquiryCTA.astro';
import { courses, chapterCount, type Course } from '../../data/courses';
import { site, contact, whatsappHref } from '../../data/site';
import { href } from '../../lib/url';

export function getStaticPaths() {
  return courses.map((course) => ({
    params: { slug: course.slug },
    props: { course },
  }));
}

interface Props {
  course: Course;
}

const { course } = Astro.props;
const chapters = chapterCount(course);
const other = courses.find((c) => c.slug !== course.slug);

const courseSchema = {
  '@context': 'https://schema.org',
  '@type': 'Course',
  name: course.title,
  description: course.summary,
  provider: {
    '@type': 'EducationalOrganization',
    name: site.legalName,
    sameAs: site.url,
  },
  hasCourseInstance: {
    '@type': 'CourseInstance',
    courseMode: 'Onsite',
    location: {
      '@type': 'Place',
      name: contact.campus.name,
      address: {
        '@type': 'PostalAddress',
        streetAddress: `${contact.campus.line1}, ${contact.campus.line2}`,
        addressLocality: contact.campus.city,
        addressRegion: contact.campus.state,
        postalCode: contact.campus.pincode,
        addressCountry: 'IN',
      },
    },
  },
};
---

<Base title={course.title} description={course.summary}>
  <script
    is:inline
    slot="head"
    type="application/ld+json"
    set:html={JSON.stringify(courseSchema)}
  />

  <!-- Hero -->
  <section class="hex-pattern border-b border-ink-100 bg-brand-50/60">
    <div class="container-page py-14 sm:py-18">
      <nav aria-label="Breadcrumb" class="text-sm">
        <ol class="flex flex-wrap items-center gap-2 text-ink-400">
          <li><a href={href("/")} class="hover:text-brand-700">Home</a></li>
          <li aria-hidden="true">/</li>
          <li><a href={href("/courses/")} class="hover:text-brand-700">Programs</a></li>
          <li aria-hidden="true">/</li>
          <li class="font-medium text-ink-600" aria-current="page">{course.shortTitle}</li>
        </ol>
      </nav>

      <div class="mt-8 grid gap-12 lg:grid-cols-[1.15fr_1fr] lg:items-start">
        <div>
          <div class="flex flex-wrap items-center gap-2.5">
            <span class="rounded-full bg-ink-900 px-3.5 py-1.5 text-xs font-bold text-white">
              {course.duration}
            </span>
            <span
              class="rounded-full border border-brand-200 bg-white px-3.5 py-1.5 text-xs font-bold text-brand-700"
            >
              Classroom only
            </span>
            <span
              class="rounded-full border border-ink-200 bg-white px-3.5 py-1.5 text-xs font-bold text-ink-600"
            >
              {course.level}
            </span>
          </div>

          <h1 class="mt-6 text-4xl leading-[1.1] sm:text-5xl">{course.title}</h1>
          <p class="mt-6 max-w-2xl text-lg leading-relaxed text-ink-600">{course.intro}</p>

          <div class="mt-9 flex flex-col gap-3 sm:flex-row">
            <a
              href={whatsappHref(
                `Hi Sidhah, I'd like to know the batch dates and fees for the ${course.title}.`,
              )}
              target="_blank"
              rel="noopener noreferrer"
              class="inline-flex items-center justify-center rounded-xl bg-brand-600 px-7 py-4 text-sm font-bold text-white shadow-lg shadow-brand-600/20 transition-colors hover:bg-brand-700"
            >
              Enquire about this program
            </a>
            <a
              href="#syllabus"
              class="inline-flex items-center justify-center rounded-xl border border-ink-200 bg-white px-7 py-4 text-sm font-bold text-ink-900 transition-colors hover:border-brand-300 hover:text-brand-700"
            >
              Jump to syllabus
            </a>
          </div>
        </div>

        <aside class="rounded-4xl border border-ink-100 bg-white p-7 shadow-lift">
          <h2 class="text-lg">Program at a glance</h2>
          <dl class="mt-5 divide-y divide-ink-100">
            {
              course.highlights.map((item) => (
                <div class="flex items-center justify-between gap-4 py-3.5">
                  <dt class="text-sm text-ink-600">{item.label}</dt>
                  <dd class="text-sm font-bold text-ink-900">{item.value}</dd>
                </div>
              ))
            }
            <div class="flex items-center justify-between gap-4 py-3.5">
              <dt class="text-sm text-ink-600">Campus</dt>
              <dd class="text-right text-sm font-bold text-ink-900">
                Infopark, Kakkanad
              </dd>
            </div>
            <div class="flex items-center justify-between gap-4 py-3.5">
              <dt class="text-sm text-ink-600">Add-on programs</dt>
              <dd class="text-sm font-bold text-brand-700">Included</dd>
            </div>
          </dl>

          <div class="mt-6 rounded-2xl bg-brand-50 p-5">
            <p class="text-sm font-bold text-ink-900">Fee structure &amp; batch dates</p>
            <p class="mt-2 text-sm leading-relaxed text-ink-600">
              Shared over a call or on your campus visit, along with the
              instalment options available.
            </p>
            <a
              href={contact.phoneHref}
              class="mt-4 inline-flex text-sm font-bold text-brand-700 hover:text-brand-800"
            >
              Call {contact.phone} →
            </a>
          </div>
        </aside>
      </div>
    </div>
  </section>

  <!-- Eligibility + outcomes -->
  <section class="container-page py-16 sm:py-20">
    <div class="grid gap-12 lg:grid-cols-2">
      <div>
        <h2 class="text-2xl sm:text-3xl">Who this is for</h2>
        <ul class="mt-6 space-y-4">
          {
            course.eligibility.map((item) => (
              <li class="flex gap-3.5">
                <svg
                  class="mt-1 h-5 w-5 shrink-0 text-brand-500"
                  viewBox="0 0 20 20"
                  fill="currentColor"
                  aria-hidden="true"
                >
                  <path
                    fill-rule="evenodd"
                    d="M10 18a8 8 0 100-16 8 8 0 000 16zm3.86-9.47a1 1 0 00-1.72-1.06l-2.7 4.37-1.23-1.23a1 1 0 10-1.42 1.42l2.1 2.1a1 1 0 001.56-.18l3.41-5.42z"
                    clip-rule="evenodd"
                  />
                </svg>
                <span class="leading-relaxed text-ink-600">{item}</span>
              </li>
            ))
          }
        </ul>
      </div>

      <div>
        <h2 class="text-2xl sm:text-3xl">What you will be able to do</h2>
        <ul class="mt-6 space-y-4">
          {
            course.outcomes.map((item) => (
              <li class="flex gap-3.5">
                <svg
                  class="mt-1 h-5 w-5 shrink-0 text-gold-600"
                  viewBox="0 0 20 20"
                  fill="currentColor"
                  aria-hidden="true"
                >
                  <path d="M10 1.5l2.6 5.3 5.9.85-4.25 4.15 1 5.85L10 14.9l-5.25 2.75 1-5.85L1.5 7.65l5.9-.85L10 1.5z" />
                </svg>
                <span class="leading-relaxed text-ink-600">{item}</span>
              </li>
            ))
          }
        </ul>
      </div>
    </div>
  </section>

  <!-- Syllabus -->
  <section id="syllabus" class="bg-ink-50/60 py-20 sm:py-24">
    <div class="container-page">
      <div class="flex flex-col gap-4 sm:flex-row sm:items-end sm:justify-between">
        <div class="max-w-2xl">
          <p class="text-xs font-bold uppercase tracking-[0.18em] text-brand-600">Syllabus</p>
          <h2 class="mt-3 text-3xl sm:text-4xl">
            {course.modules.length} modules, {chapters} chapters
          </h2>
          <p class="mt-4 leading-relaxed text-ink-600">
            Taught in sequence across {course.duration.toLowerCase()} of classroom
            sessions. Tap a module to see its chapters.
          </p>
        </div>
        <div class="flex gap-2">
          <button
            type="button"
            data-syllabus-action="expand"
            class="rounded-xl border border-ink-200 bg-white px-4 py-2.5 text-sm font-semibold text-ink-600 transition-colors hover:border-brand-300 hover:text-brand-700"
          >
            Expand all
          </button>
          <button
            type="button"
            data-syllabus-action="collapse"
            class="rounded-xl border border-ink-200 bg-white px-4 py-2.5 text-sm font-semibold text-ink-600 transition-colors hover:border-brand-300 hover:text-brand-700"
          >
            Collapse all
          </button>
        </div>
      </div>

      <div id="syllabus-list" class="mt-12">
        <SyllabusAccordion modules={course.modules} />
      </div>
    </div>
  </section>

  <!-- Careers -->
  <section class="container-page py-20 sm:py-24">
    <div class="rounded-4xl border border-ink-100 bg-white p-8 shadow-card sm:p-12">
      <div class="grid gap-10 lg:grid-cols-[0.85fr_1.15fr] lg:items-center">
        <div>
          <p class="text-xs font-bold uppercase tracking-[0.18em] text-brand-600">Careers</p>
          <h2 class="mt-3 text-3xl">Where graduates go</h2>
          <p class="mt-4 leading-relaxed text-ink-600">
            Roles our {course.duration.toLowerCase()} program prepares you for
            across hospitals, clinics, diagnostic chains and insurance desks.
          </p>
        </div>
        <ul class="flex flex-wrap gap-2.5">
          {
            course.careers.map((role) => (
              <li class="rounded-xl border border-ink-100 bg-ink-50/70 px-4 py-2.5 text-sm font-semibold text-ink-800">
                {role}
              </li>
            ))
          }
        </ul>
      </div>
    </div>
  </section>

  {
    other && (
      <section class="container-page pb-20 sm:pb-24">
        <a
          href={href(`/courses/${other.slug}/`)}
          class="group flex flex-col gap-4 rounded-3xl border border-ink-100 bg-ink-50/60 p-7 transition-colors hover:border-brand-300 hover:bg-brand-50/50 sm:flex-row sm:items-center sm:justify-between"
        >
          <div>
            <p class="text-xs font-bold uppercase tracking-[0.16em] text-ink-400">
              Also available
            </p>
            <p class="mt-2 text-xl font-bold text-ink-900">{other.title}</p>
            <p class="mt-1 text-sm text-ink-600">
              {other.duration} · {other.modules.length} modules · classroom only
            </p>
          </div>
          <span class="inline-flex items-center gap-2 text-sm font-bold text-brand-700 group-hover:gap-3 motion-safe:transition-all">
            View program
            <svg class="h-4 w-4" viewBox="0 0 20 20" fill="currentColor" aria-hidden="true">
              <path
                fill-rule="evenodd"
                d="M3 10a1 1 0 011-1h10.6l-3.3-3.3a1 1 0 111.4-1.4l5 5a1 1 0 010 1.4l-5 5a1 1 0 01-1.4-1.4l3.3-3.3H4a1 1 0 01-1-1z"
                clip-rule="evenodd"
              />
            </svg>
          </span>
        </a>
      </section>
    )
  }

  <EnquiryCTA
    title={`Ready to join the ${course.duration.toLowerCase()} program?`}
    description="Visit the campus, meet the faculty and sit in on a live class before you pay anything. Message us and we will hold a slot."
    message={`Hi Sidhah, I'm interested in the ${course.title}. Could you share the batch dates and fees?`}
  />
</Base>

<script>
  const list = document.getElementById('syllabus-list');

  document.querySelectorAll<HTMLButtonElement>('[data-syllabus-action]').forEach((button) => {
    button.addEventListener('click', () => {
      const shouldOpen = button.dataset.syllabusAction === 'expand';
      list?.querySelectorAll('details').forEach((item) => {
        item.open = shouldOpen;
      });
    });
  });
</script>
