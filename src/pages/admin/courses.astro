---
export const prerender = false;

import Admin from '../../layouts/Admin.astro';
import { checkCsrf, csrfToken } from '../../lib/server/auth';
import { db } from '../../lib/server/db';
import { checkAmount, listCourses } from '../../lib/server/invoices';
import { formatRupees, parseAmount, printable } from '../../lib/format';

const user = Astro.locals.user!;
let error = '';
let notice = '';

if (Astro.request.method === 'POST') {
  const form = await Astro.request.formData();
  const action = String(form.get('action') ?? '');

  if (!checkCsrf(Astro, form.get('csrf'))) {
    error = 'Your session expired. Please try again.';
  } else if (action === 'add') {
    const name = String(form.get('name') ?? '').trim();
    const rawAmount = String(form.get('defaultAmount') ?? '').trim();
    const amountError = rawAmount ? checkAmount(rawAmount) : null;
    const amount = rawAmount && !amountError ? parseAmount(rawAmount) : null;

    if (!name) error = 'Enter a course name.';
    else if (name.length > 120) error = 'Keep the course name under 120 characters.';
    // The course name is printed on every invoice, so it must be in the PDF font.
    else if (!printable(name)) error = 'The course name contains characters the invoice cannot print. Please use English letters.';
    else if (amountError) error = `Standard fee: ${amountError} Or leave it blank.`;
    else {
      const inserted = await db`
        insert into courses (name, default_amount) values (${name}, ${amount})
        on conflict do nothing returning id
      `;
      if (inserted.length === 0) error = `“${name}” is already on the list.`;
      else notice = `Added “${name}”.`;
    }
  } else if (action === 'toggle') {
    const id = Number(form.get('id'));
    // Courses are disabled, never deleted: past invoices reference them.
    const [row] = Number.isInteger(id) && id > 0
      ? await db<{ name: string; active: boolean }>`
          update courses set active = not active where id = ${id} returning name, active
        `
      : [];
    if (row) notice = `“${row.name}” is now ${row.active ? 'available' : 'hidden from the invoice form'}.`;
  }
}

const courses = await listCourses(true);
const field =
  'w-full rounded-xl border border-ink-200 px-3.5 py-2.5 text-ink-900 outline-none transition focus:border-brand-600 focus:ring-2 focus:ring-brand-100';
const csrf = csrfToken(Astro);
---

<Admin title="Courses" user={user} csrf={csrf} section="courses">
  <h1 class="text-3xl">Courses</h1>
  <p class="mt-1.5 text-ink-400">
    These fill the course dropdown on the invoice form. Set a standard fee to prefill the amount.
  </p>

  {error && <p role="alert" class="mt-6 rounded-xl border border-red-200 bg-red-50 px-4 py-3 text-sm font-medium text-red-800">{error}</p>}
  {notice && <p class="mt-6 rounded-xl border border-green-200 bg-green-50 px-4 py-3 text-sm font-medium text-green-800">{notice}</p>}

  <form method="post" class="mt-6 grid gap-3 rounded-2xl border border-ink-100 bg-white p-4 shadow-card sm:grid-cols-[minmax(0,2fr)_minmax(0,1fr)_auto]">
    <input type="hidden" name="csrf" value={csrf} />
    <input type="hidden" name="action" value="add" />
    <div>
      <label for="name" class="mb-1.5 block text-xs font-semibold tracking-wide text-ink-400 uppercase">Course name</label>
      <input id="name" name="name" required placeholder="Diploma in Hospital Administration" class={field} />
    </div>
    <div>
      <label for="defaultAmount" class="mb-1.5 block text-xs font-semibold tracking-wide text-ink-400 uppercase">
        Standard fee (optional)
      </label>
      <input id="defaultAmount" name="defaultAmount" inputmode="decimal" placeholder="25000" class={field} />
    </div>
    <div class="flex items-end">
      <button type="submit" class="rounded-xl bg-brand-800 px-5 py-2.5 font-semibold text-white transition hover:bg-brand-900">
        Add course
      </button>
    </div>
  </form>

  <ul class="mt-6 divide-y divide-ink-100 overflow-hidden rounded-2xl border border-ink-100 bg-white shadow-card">
    {
      courses.map((course) => (
        <li class="flex flex-wrap items-center gap-4 px-5 py-4">
          <div class="min-w-0 flex-1">
            <p class:list={['font-semibold', course.active ? 'text-ink-900' : 'text-ink-400 line-through']}>
              {course.name}
            </p>
            <p class="text-sm text-ink-400">
              {course.default_amount ? `Standard fee ${formatRupees(course.default_amount)}` : 'No standard fee'}
            </p>
          </div>
          {!course.active && (
            <span class="rounded-full bg-ink-100 px-2.5 py-1 text-xs font-semibold text-ink-400">Hidden</span>
          )}
          <form method="post">
            <input type="hidden" name="csrf" value={csrf} />
            <input type="hidden" name="action" value="toggle" />
            <input type="hidden" name="id" value={String(course.id)} />
            <button
              type="submit"
              class="rounded-lg border border-ink-200 px-3 py-1.5 text-sm font-semibold text-ink-600 transition hover:border-ink-300 hover:text-ink-900"
            >
              {course.active ? 'Hide' : 'Restore'}
            </button>
          </form>
        </li>
      ))
    }
    {
      courses.length === 0 && (
        <li class="px-5 py-12 text-center text-sm text-ink-400">
          No courses yet. Add the first one above.
        </li>
      )
    }
  </ul>
</Admin>
