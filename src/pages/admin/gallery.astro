---
export const prerender = false;

import Admin from '../../layouts/Admin.astro';
import { checkCsrf, csrfToken } from '../../lib/server/auth';
import { db } from '../../lib/server/db';
import { PhotoError, saveUpload } from '../../lib/server/content';

const user = Astro.locals.user!;
const csrf = csrfToken(Astro);
let notice = '';
let error = '';

if (Astro.request.method === 'POST') {
  const form = await Astro.request.formData();
  const action = String(form.get('action') ?? '');
  const id = Number(form.get('id'));

  if (!checkCsrf(Astro, form.get('csrf'))) error = 'Your session expired. Please try again.';
  else if (action === 'upload') {
    const files = form.getAll('photos');
    const caption = String(form.get('caption') ?? '').trim().slice(0, 200) || null;
    const [{ next }] = await db<{ next: number }>`select coalesce(max(sort_order), 0) + 1 as next from gallery`;
    let added = 0;
    try {
      for (const file of files) {
        const photoId = await saveUpload(file);
        if (!photoId) continue;
        await db`insert into gallery (photo_id, caption, sort_order) values (${photoId}, ${caption}, ${next + added})`;
        added++;
      }
      notice = added ? `Added ${added} photo${added === 1 ? '' : 's'}.` : 'Choose at least one photo.';
    } catch (e) {
      if (!(e instanceof PhotoError)) console.error('Gallery upload failed', e);
      error = `${added ? `Added ${added}, then stopped: ` : ''}${e instanceof PhotoError ? e.message : 'Could not upload. Please try again.'}`;
    }
  } else if (action === 'save' && Number.isInteger(id) && id > 0) {
    const caption = String(form.get('caption') ?? '').trim().slice(0, 200) || null;
    await db`update gallery set caption = ${caption}, sort_order = ${Number(form.get('sortOrder')) || 0} where id = ${id}`;
    notice = 'Saved.';
  } else if (action === 'delete' && Number.isInteger(id) && id > 0) {
    // Deleting the media row cascades to the gallery row.
    await db`delete from media where id = (select photo_id from gallery where id = ${id})`;
    notice = 'Photo deleted.';
  }
}

const photos = await db<{ id: number; photo_id: number; caption: string | null; sort_order: number }>`
  select id, photo_id, caption, sort_order from gallery order by sort_order, id
`;
const field =
  'w-full rounded-xl border border-ink-200 px-3 py-2 text-sm text-ink-900 outline-none transition focus:border-brand-600 focus:ring-2 focus:ring-brand-100';
---

<Admin title="Gallery" user={user} csrf={csrf} section="gallery">
  <h1 class="text-3xl">Gallery</h1>
  <p class="mt-1.5 text-ink-400">Photos shown in the graduation gallery on the Placements page. The first photo is shown large.</p>

  {error && <p role="alert" class="mt-6 rounded-xl border border-red-200 bg-red-50 px-4 py-3 text-sm font-medium text-red-800">{error}</p>}
  {notice && <p class="mt-6 rounded-xl border border-green-200 bg-green-50 px-4 py-3 text-sm font-medium text-green-800">{notice}</p>}

  <form method="post" enctype="multipart/form-data" class="mt-6 grid gap-4 rounded-2xl border border-ink-100 bg-white p-5 shadow-card sm:grid-cols-[minmax(0,1fr)_minmax(0,1fr)_auto] sm:items-end">
    <input type="hidden" name="csrf" value={csrf} />
    <input type="hidden" name="action" value="upload" />
    <div>
      <label for="photos" class="mb-1.5 block text-sm font-semibold text-ink-800">Photos</label>
      <input id="photos" name="photos" type="file" multiple required accept="image/jpeg,image/png,image/webp" data-photo class="text-sm" />
      <p class="mt-1.5 text-xs text-ink-400">Up to 10 at a time.</p>
    </div>
    <div>
      <label for="caption" class="mb-1.5 block text-sm font-semibold text-ink-800">Description (optional)</label>
      <input id="caption" name="caption" placeholder="e.g. 2025 graduation ceremony" class={field} />
    </div>
    <button type="submit" class="rounded-xl bg-brand-800 px-5 py-2.5 font-semibold text-white transition hover:bg-brand-900 disabled:opacity-50">
      Upload
    </button>
  </form>

  <ul class="mt-6 grid gap-5 sm:grid-cols-2 lg:grid-cols-3">
    {photos.map((photo) => (
      <li class="overflow-hidden rounded-2xl border border-ink-100 bg-white shadow-card">
        <img src={`/media/${photo.photo_id}`} alt={photo.caption ?? ''} loading="lazy" class="aspect-4/3 w-full object-cover" />
        <form method="post" class="space-y-2 p-4">
          <input type="hidden" name="csrf" value={csrf} />
          <input type="hidden" name="id" value={String(photo.id)} />
          <input name="caption" value={photo.caption ?? ''} placeholder="Description" aria-label="Description" class={field} />
          <div class="flex items-center gap-2">
            <label class="text-xs text-ink-400" for={`order-${photo.id}`}>Order</label>
            <input id={`order-${photo.id}`} name="sortOrder" type="number" value={String(photo.sort_order)} class:list={[field, 'w-20']} />
            <button type="submit" name="action" value="save" class="ml-auto rounded-lg border border-ink-200 px-3 py-1.5 text-sm font-semibold text-ink-700 hover:border-ink-300">Save</button>
            <button type="submit" name="action" value="delete" onclick="return confirm('Delete this photo?')" class="rounded-lg border border-red-200 px-3 py-1.5 text-sm font-semibold text-red-700 hover:bg-red-50">Delete</button>
          </div>
        </form>
      </li>
    ))}
  </ul>
  {photos.length === 0 && <p class="mt-6 rounded-2xl border border-dashed border-ink-200 bg-white px-6 py-12 text-center text-sm text-ink-400">No photos yet.</p>}
</Admin>
