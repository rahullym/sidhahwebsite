---
export const prerender = false;

import Admin from '../../../layouts/Admin.astro';
import { checkCsrf, csrfToken } from '../../../lib/server/auth';
import { db } from '../../../lib/server/db';
import { deleteMedia } from '../../../lib/server/content';
import { formatDate } from '../../../lib/format';

const user = Astro.locals.user!;
const csrf = csrfToken(Astro);
let notice = Astro.url.searchParams.has('saved') ? 'Saved.' : '';

if (Astro.request.method === 'POST') {
  const form = await Astro.request.formData();
  const id = Number(form.get('id'));
  if (checkCsrf(Astro, form.get('csrf')) && form.get('action') === 'delete' && Number.isInteger(id) && id > 0) {
    const [row] = await db<{ title: string; cover_id: number | null }>`delete from posts where id = ${id} returning title, cover_id`;
    if (row) {
      await deleteMedia(row.cover_id);
      notice = `Deleted “${row.title}”.`;
    }
  }
}

const posts = await db<{ id: number; title: string; slug: string; published: boolean; published_at: string | null; updated_at: string }>`
  select id, title, slug, published, published_at, updated_at from posts order by coalesce(published_at, updated_at) desc
`;
---

<Admin title="Blog" user={user} csrf={csrf} section="blog">
  <div class="flex flex-wrap items-end justify-between gap-4">
    <div>
      <h1 class="text-3xl">Blog</h1>
      <p class="mt-1.5 text-ink-400">Posts appear at /blog once published. Drafts are only visible here.</p>
    </div>
    <a href="/admin/blog/new" class="rounded-xl bg-brand-800 px-5 py-3 font-semibold text-white shadow-card transition hover:bg-brand-900">+ New post</a>
  </div>

  {notice && <p class="mt-6 rounded-xl border border-green-200 bg-green-50 px-4 py-3 text-sm font-medium text-green-800">{notice}</p>}

  <ul class="mt-6 divide-y divide-ink-100 overflow-hidden rounded-2xl border border-ink-100 bg-white shadow-card">
    {posts.map((post) => (
      <li class="flex flex-wrap items-center gap-4 px-5 py-4">
        <div class="min-w-0 flex-1">
          <p class="font-semibold text-ink-900">{post.title}</p>
          <p class="text-sm text-ink-400">
            {post.published && post.published_at ? `Published ${formatDate(post.published_at)}` : 'Draft'}
          </p>
        </div>
        {post.published
          ? <span class="rounded-full bg-green-50 px-2.5 py-1 text-xs font-semibold text-green-700">Live</span>
          : <span class="rounded-full bg-ink-100 px-2.5 py-1 text-xs font-semibold text-ink-400">Draft</span>}
        {post.published && <a href={`/blog/${post.slug}/`} target="_blank" rel="noopener" class="text-sm font-semibold text-brand-600 hover:text-brand-800">View ↗</a>}
        <a href={`/admin/blog/${post.id}`} class="rounded-lg bg-brand-800 px-3 py-1.5 text-sm font-semibold text-white hover:bg-brand-900">Edit</a>
        <form method="post" onsubmit={`return confirm(${JSON.stringify(`Delete “${post.title}”? This cannot be undone.`)})`}>
          <input type="hidden" name="csrf" value={csrf} />
          <input type="hidden" name="action" value="delete" />
          <input type="hidden" name="id" value={String(post.id)} />
          <button type="submit" class="rounded-lg border border-red-200 px-3 py-1.5 text-sm font-semibold text-red-700 hover:bg-red-50">Delete</button>
        </form>
      </li>
    ))}
    {posts.length === 0 && <li class="px-5 py-12 text-center text-sm text-ink-400">No posts yet. Write the first one.</li>}
  </ul>
</Admin>
