---
import Base from '../layouts/Base.astro';
import SectionHeading from '../components/SectionHeading.astro';
import CourseCard from '../components/CourseCard.astro';
import PlacementCard from '../components/PlacementCard.astro';
import Accreditations from '../components/Accreditations.astro';
import Photo from '../components/Photo.astro';
import EnquiryCTA from '../components/EnquiryCTA.astro';
import { courses, addOns, addOnNote } from '../data/courses';
import { placements, hiringHospitals } from '../data/placements';
import { contact, whatsappHref } from '../data/site';
import { href } from '../lib/url';

const featuredPlacements = placements.slice(0, 4);

const whyOffline = [
  {
    title: 'A teacher in the room with you',
    body: 'Ask the question the moment it occurs to you. Faculty correct your work at the desk, not three days later in a comment box.',
    icon: 'M4 5h16a1 1 0 011 1v10a1 1 0 01-1 1H4a1 1 0 01-1-1V6a1 1 0 011-1zm4 4h8m-8 4h5m-1 4l-2 4m4-4l2 4',
  },
  {
    title: 'Hospital visits, not screen recordings',
    body: 'Scheduled visits to partner hospitals in and around Kochi. You see the OP desk, the records room and the insurance counter in operation.',
    icon: 'M3 21h18M5 21V8l7-4 7 4v13M10 12h4M12 10v4M10 21v-4h4v4',
  },
  {
    title: 'Practice with people, not prompts',
    body: 'Front-desk role plays, grievance handling, mock audits and interview panels — every soft skill this job needs is rehearsed face to face.',
    icon: 'M17 20h5v-2a3 3 0 00-5.36-1.86M17 20H7m10 0v-2c0-.66-.13-1.3-.36-1.86M7 20H2v-2a3 3 0 015.36-1.86M7 20v-2c0-.66.13-1.3.36-1.86m0 0a5 5 0 019.28 0M15 7a3 3 0 11-6 0 3 3 0 016 0z',
  },
  {
    title: 'Batches small enough to be noticed',
    body: 'We cap seats per batch so faculty know where every student stands. Nobody drifts through a classroom the way they drift through a video course.',
    icon: 'M9 12l2 2 4-4M7.8 4.6a4 4 0 018.4 0 4 4 0 014 4 4 4 0 010 6.8 4 4 0 01-4 4 4 4 0 01-8.4 0 4 4 0 01-4-4 4 4 0 010-6.8 4 4 0 014-4z',
  },
];

const dayInLife = [
  {
    time: 'Morning',
    title: 'Core module session',
    body: 'Faculty-led teaching on the day’s chapter, with case discussion drawn from working hospitals.',
  },
  {
    time: 'Midday',
    title: 'Practical & documentation lab',
    body: 'Hands-on work with HIS software, insurance forms, quality checklists and hospital records.',
  },
  {
    time: 'Afternoon',
    title: 'Skills & assessment',
    body: 'Role plays, presentations, chapter tests, and add-on sessions in spoken English, Tally or interview prep.',
  },
];

const faqs = [
  {
    q: 'Do you offer online or recorded classes?',
    a: 'No. Every Sidhah program is taught in person at our Infopark campus in Kakkanad. We made this choice deliberately — hospital administration is a people-facing job, and the practical work, hospital visits and interview training that get students hired simply do not translate to a screen.',
  },
  {
    q: 'Which program should I choose?',
    a: 'The 6-month Diploma is the fastest route into a hospital administration role and covers four modules. The 1-year PG Diploma adds public health, healthcare analytics, and risk and strategic operations — three more modules aimed at students who want to grow into management rather than start at the desk. Visit the campus and we will help you pick.',
  },
  {
    q: 'What background do I need?',
    a: 'Any degree is accepted for the PG Diploma, and Plus Two or above for the Diploma. Students join us from nursing, paramedical, life sciences, commerce and arts backgrounds. No prior hospital experience is expected.',
  },
  {
    q: 'Do you help with placement?',
    a: 'Yes. Interview training, resume preparation and mock HR panels are built into both programs at no extra cost, and we connect students with hospitals and healthcare employers in and around Kochi.',
  },
  {
    q: 'Where exactly is the campus?',
    a: `We are at ${contact.campus.line1}, ${contact.campus.line2}, ${contact.campus.city} — inside the Infopark campus, easily reachable from Kakkanad, Edappally, Vyttila and Aluva.`,
  },
  {
    q: 'How do I apply?',
    a: 'Message us on WhatsApp or call the number on this page. We will tell you when the next batch starts, what the fee structure looks like, and book you a time to visit the classroom.',
  },
];

const faqSchema = {
  '@context': 'https://schema.org',
  '@type': 'FAQPage',
  mainEntity: faqs.map((faq) => ({
    '@type': 'Question',
    name: faq.q,
    acceptedAnswer: { '@type': 'Answer', text: faq.a },
  })),
};

const addOnIcons: Record<string, string> = {
  interview:
    'M8 10h8M8 14h5M21 12a8 8 0 01-8 8H7l-4 3v-7a8 8 0 018-8h2a8 8 0 018 8z',
  english: 'M3 5h12M9 3v2m1.5 14L15 5m0 0l4.5 14M7 8c0 4-2 7-4 8m2-4c2 1 4 2 6 2',
  tally: 'M9 7h6M9 11h6M9 15h3M5 3h14a2 2 0 012 2v14a2 2 0 01-2 2H5a2 2 0 01-2-2V5a2 2 0 012-2z',
};
---

<Base
  title="Sidhah — Hospital Administration Courses in Kochi | Classroom Only"
  description="Sidhah Edutech runs classroom-only hospital administration diplomas at Infopark, Kakkanad. 1-year PG Diploma and 6-month Diploma with hospital visits, interview training and placement support."
  suffix={false}
>
  <script
    is:inline
    slot="head"
    type="application/ld+json"
    set:html={JSON.stringify(faqSchema)}
  />

  <!-- Hero -->
  <section class="relative overflow-hidden bg-gradient-to-b from-brand-50 via-brand-50/40 to-white">
    <div class="hex-pattern absolute inset-0 opacity-70" aria-hidden="true"></div>
    <div
      class="pointer-events-none absolute -right-32 top-0 h-[30rem] w-[30rem] rounded-full bg-brand-200/40 blur-3xl"
      aria-hidden="true"
    >
    </div>

    <div class="container-page relative py-16 sm:py-24 lg:py-28">
      <div class="grid items-center gap-14 lg:grid-cols-[1.1fr_1fr]">
        <div>
          <p
            class="inline-flex items-center gap-2 rounded-full border border-brand-200 bg-white px-4 py-1.5 text-xs font-bold uppercase tracking-[0.14em] text-brand-700 shadow-sm"
          >
            <span class="relative flex h-2 w-2">
              <span
                class="absolute inline-flex h-full w-full animate-ping rounded-full bg-brand-400 opacity-75"
              ></span>
              <span class="relative inline-flex h-2 w-2 rounded-full bg-brand-600"></span>
            </span>
            Offline classroom batches · Infopark, Kochi
          </p>

          <h1 class="mt-7 text-4xl leading-[1.08] sm:text-5xl lg:text-[3.5rem]">
            Hospital administration,{' '}
            <span class="text-brand-600">taught in a real classroom.</span>
          </h1>

          <p class="mt-6 max-w-xl text-lg leading-relaxed text-ink-600">
            No recorded videos. No login portal. Just faculty in front of you,
            hospital visits around Kochi, and a small batch that finishes job-ready.
            Two programs, both fully in person at our Infopark campus.
          </p>

          <div class="mt-9 flex flex-col gap-3 sm:flex-row">
            <a
              href={href("/courses/")}
              class="inline-flex items-center justify-center gap-2 rounded-xl bg-brand-600 px-7 py-4 text-sm font-bold text-white shadow-lg shadow-brand-600/20 transition-colors hover:bg-brand-700"
            >
              Explore the programs
              <svg class="h-4 w-4" viewBox="0 0 20 20" fill="currentColor" aria-hidden="true">
                <path
                  fill-rule="evenodd"
                  d="M3 10a1 1 0 011-1h10.6l-3.3-3.3a1 1 0 111.4-1.4l5 5a1 1 0 010 1.4l-5 5a1 1 0 01-1.4-1.4l3.3-3.3H4a1 1 0 01-1-1z"
                  clip-rule="evenodd"></path>
              </svg>
            </a>
            <a
              href={whatsappHref(
                "Hi Sidhah, I'd like to book a campus visit and know about the next batch.",
              )}
              target="_blank"
              rel="noopener noreferrer"
              class="inline-flex items-center justify-center gap-2 rounded-xl border border-ink-200 bg-white px-7 py-4 text-sm font-bold text-ink-900 transition-colors hover:border-brand-300 hover:text-brand-700"
            >
              Book a campus visit
            </a>
          </div>

          <dl class="mt-12 grid max-w-lg grid-cols-3 gap-4 border-t border-ink-200/70 pt-8 sm:gap-6">
            <div>
              <dd class="font-display text-3xl font-extrabold tabular-nums text-ink-900 sm:text-4xl">
                2
              </dd>
              <dt class="mt-1.5 text-xs font-medium text-ink-400">Programs</dt>
            </div>
            <div>
              <dd class="font-display text-3xl font-extrabold tabular-nums text-ink-900 sm:text-4xl">
                60
              </dd>
              <dt class="mt-1.5 text-xs font-medium text-ink-400">Chapters taught</dt>
            </div>
            <div>
              <dd class="font-display text-3xl font-extrabold text-brand-600 sm:text-4xl">Zero</dd>
              <dt class="mt-1.5 text-xs font-medium text-ink-400">Online classes</dt>
            </div>
          </dl>
        </div>

        <div class="relative">
          <Photo
            name="hero-classroom"
            alt="A hospital administration class in session at the Sidhah Infopark campus"
            ratio="aspect-4/3"
            class="rounded-4xl shadow-lift"
            sizes="(min-width: 1024px) 32rem, 90vw"
            widths={[480, 768, 1024]}
            icon="classroom"
            label="Classroom photo"
            tone="dark"
            priority
          />

          <div
            class="relative z-10 mx-4 -mt-20 rounded-3xl border border-ink-100 bg-white/95 p-6 shadow-lift backdrop-blur sm:mx-8 sm:p-7"
          >
            <p class="text-xs font-bold uppercase tracking-[0.16em] text-brand-600">
              Admissions open
            </p>
            <h2 class="mt-2 text-xl">Next classroom batch</h2>

            <ul class="mt-5 space-y-3">
              {
                courses.map((course) => (
                  <li>
                    <a
                      href={href(`/courses/${course.slug}/`)}
                      class="flex items-center gap-4 rounded-2xl border border-ink-100 p-3.5 transition-colors hover:border-brand-300 hover:bg-brand-50/50"
                    >
                      <span class="flex h-12 w-12 shrink-0 flex-col items-center justify-center rounded-xl bg-brand-50 text-center">
                        <span class="text-sm font-extrabold leading-none text-brand-700">
                          {course.duration.split(' ')[0]}
                        </span>
                        <span class="mt-0.5 text-[0.6rem] font-bold uppercase text-brand-600">
                          {course.duration.split(' ')[1]}
                        </span>
                      </span>
                      <span class="min-w-0 flex-1">
                        <span class="block text-sm font-bold text-ink-900">
                          {course.shortTitle}
                        </span>
                        <span class="mt-0.5 block text-xs text-ink-400">
                          {course.modules.length} modules · classroom only
                        </span>
                      </span>
                      <svg
                        class="h-4 w-4 shrink-0 text-ink-400"
                        viewBox="0 0 20 20"
                        fill="currentColor"
                        aria-hidden="true"
                      >
                        <path
                          fill-rule="evenodd"
                          d="M7.3 4.3a1 1 0 011.4 0l5 5a1 1 0 010 1.4l-5 5a1 1 0 01-1.4-1.4L11.6 10 7.3 5.7a1 1 0 010-1.4z"
                          clip-rule="evenodd"
                        />
                      </svg>
                    </a>
                  </li>
                ))
              }
            </ul>

            <a
              href={contact.phoneHref}
              class="mt-5 flex items-center justify-center gap-2 rounded-xl bg-ink-900 px-5 py-3.5 text-sm font-bold text-white transition-colors hover:bg-ink-800"
            >
              Call {contact.phone}
            </a>
          </div>
        </div>
      </div>
    </div>
  </section>

  <!-- Accreditations -->
  <section class="border-b border-ink-100 bg-white py-12">
    <div class="container-page">
      <Accreditations />
    </div>
  </section>

  <!-- Why offline -->
  <section class="container-page py-20 sm:py-24">
    <div class="grid gap-12 lg:grid-cols-[0.8fr_1.2fr] lg:items-start lg:gap-16">
      <div class="lg:sticky lg:top-28">
        <SectionHeading
          eyebrow="Why we stay offline"
          title="Some things do not survive the journey to a screen"
          description="Plenty of institutes moved their hospital administration courses online. We did the opposite, and the reasons show up in how our students interview."
          align="left"
        />
        <Photo
          name="why-offline"
          alt="Faculty working with students during a classroom session"
          ratio="aspect-4/5"
          class="mt-10 rounded-4xl shadow-card"
          sizes="(min-width: 1024px) 24rem, 90vw"
          widths={[400, 640, 900]}
          icon="team"
          label="Students in session"
        />
      </div>

      <div class="grid gap-6 sm:grid-cols-2">
      {
        whyOffline.map((item) => (
          <div data-reveal class="rounded-3xl border border-ink-100 bg-white p-7 shadow-card">
            <span class="inline-flex h-12 w-12 items-center justify-center rounded-2xl bg-brand-50 text-brand-600">
              <svg
                class="h-6 w-6"
                viewBox="0 0 24 24"
                fill="none"
                stroke="currentColor"
                stroke-width="1.7"
                stroke-linecap="round"
                stroke-linejoin="round"
                aria-hidden="true"
              >
                <path d={item.icon} />
              </svg>
            </span>
            <h3 class="mt-5 text-xl">{item.title}</h3>
            <p class="mt-3 leading-relaxed text-ink-600">{item.body}</p>
          </div>
        ))
      }
      </div>
    </div>
  </section>

  <!-- Full-bleed campus band -->
  <section aria-label="Life at the Infopark campus" class="grid grid-cols-2 gap-1 lg:grid-cols-4">
    <Photo
      name="campus-1"
      data-reveal-index="1"
      alt="The Sidhah classroom at Geo Infopark"
      ratio="aspect-4/3"
      sizes="(min-width: 1024px) 25vw, 50vw"
      widths={[400, 700]}
      icon="classroom"
      label="Classroom"
      tint={0}
    />
    <Photo
      name="campus-2"
      data-reveal-index="2"
      alt="Students working in the computer lab"
      ratio="aspect-4/3"
      sizes="(min-width: 1024px) 25vw, 50vw"
      widths={[400, 700]}
      icon="records"
      label="Computer lab"
      tint={1}
    />
    <Photo
      name="campus-3"
      data-reveal-index="3"
      alt="A hospital visit with students on the floor"
      ratio="aspect-4/3"
      sizes="(min-width: 1024px) 25vw, 50vw"
      widths={[400, 700]}
      icon="hospital"
      label="Hospital visit"
      tint={2}
    />
    <Photo
      name="campus-4"
      data-reveal-index="4"
      alt="Mock interview practice with faculty"
      ratio="aspect-4/3"
      sizes="(min-width: 1024px) 25vw, 50vw"
      widths={[400, 700]}
      icon="interview"
      label="Interview practice"
      tint={3}
    />
  </section>

  <!-- Programs -->
  <section class="bg-ink-50/60 py-20 sm:py-24">
    <div class="container-page">
      <SectionHeading
        eyebrow="Our programs"
        title="Two ways into hospital administration"
        description="Both run entirely in the classroom, both include the add-on programs, both end with interview training and placement support."
      />

      <div class="mt-14 grid gap-7 lg:grid-cols-2">
        {courses.map((course) => <CourseCard course={course} />)}
      </div>
    </div>
  </section>

  <!-- Placements -->
  <section class="container-page py-20 sm:py-24">
    <div class="flex flex-col gap-6 sm:flex-row sm:items-end sm:justify-between">
      <SectionHeading
        eyebrow="Where our students are"
        title="They came from Chemistry, Economics, teaching"
        description="And they now work in hospital departments around Kochi. Every face here sat in the classroom you are considering."
        align="left"
        class="max-w-xl"
      />
      <a
        href={href("/placements/")}
        class="inline-flex shrink-0 items-center gap-2 rounded-xl border border-ink-200 bg-white px-6 py-3.5 text-sm font-bold text-ink-900 transition-colors hover:border-brand-300 hover:text-brand-700"
      >
        All placements
        <svg class="h-4 w-4" viewBox="0 0 20 20" fill="currentColor" aria-hidden="true">
          <path
            fill-rule="evenodd"
            d="M3 10a1 1 0 011-1h10.6l-3.3-3.3a1 1 0 111.4-1.4l5 5a1 1 0 010 1.4l-5 5a1 1 0 01-1.4-1.4l3.3-3.3H4a1 1 0 01-1-1z"
            clip-rule="evenodd"></path>
        </svg>
      </a>
    </div>

    <div class="mt-14 grid gap-6 sm:grid-cols-2 lg:grid-cols-4">
      {featuredPlacements.map((placement) => <PlacementCard placement={placement} />)}
    </div>

    <p class="mt-10 text-center text-sm font-medium text-ink-400">
      Hiring hospitals include {hiringHospitals.join(' · ')}
    </p>
  </section>

  <!-- Add-ons -->
  <section class="bg-ink-50/60 py-20 sm:py-24">
    <div class="container-page">
      <SectionHeading
        eyebrow="Add-on programs"
        title="The skills that get you through the interview"
        description={addOnNote}
      />

      <div class="mt-14 grid gap-6 md:grid-cols-3">
      {
        addOns.map((addOn) => (
          <div data-reveal class="rounded-3xl border border-ink-100 bg-white p-7 shadow-card">
            <span class="inline-flex h-12 w-12 items-center justify-center rounded-2xl bg-gold-500/12 text-gold-600">
              <svg
                class="h-6 w-6"
                viewBox="0 0 24 24"
                fill="none"
                stroke="currentColor"
                stroke-width="1.7"
                stroke-linecap="round"
                stroke-linejoin="round"
                aria-hidden="true"
              >
                <path d={addOnIcons[addOn.icon]} />
              </svg>
            </span>
            <h3 class="mt-5 text-xl">{addOn.title}</h3>
            <p class="mt-3 leading-relaxed text-ink-600">{addOn.description}</p>
          </div>
        ))
      }
      </div>
    </div>
  </section>

  <!-- A day at the campus -->
  <section class="bg-ink-900 py-20 text-white sm:py-24">
    <div class="container-page">
      <div class="grid gap-14 lg:grid-cols-[0.9fr_1.1fr] lg:items-start">
        <div>
          <p class="text-xs font-bold uppercase tracking-[0.18em] text-brand-300">
            Campus life
          </p>
          <h2 class="mt-3 text-3xl text-white sm:text-4xl">A day in the classroom</h2>
          <p class="mt-4 leading-relaxed text-ink-200">
            Structured, supervised and in person — the rhythm that turns a
            syllabus into someone a hospital wants to hire.
          </p>
          <a
            href={href("/campus/")}
            class="mt-8 inline-flex items-center gap-2 rounded-xl bg-white px-6 py-3.5 text-sm font-bold text-ink-900 transition-colors hover:bg-ink-100"
          >
            See the campus
            <svg class="h-4 w-4" viewBox="0 0 20 20" fill="currentColor" aria-hidden="true">
              <path
                fill-rule="evenodd"
                d="M3 10a1 1 0 011-1h10.6l-3.3-3.3a1 1 0 111.4-1.4l5 5a1 1 0 010 1.4l-5 5a1 1 0 01-1.4-1.4l3.3-3.3H4a1 1 0 01-1-1z"
                clip-rule="evenodd"></path>
            </svg>
          </a>
        </div>

        <ol class="relative space-y-8 border-l border-white/15 pl-8">
          {
            dayInLife.map((slot) => (
              <li class="relative">
                <span class="absolute -left-[2.3rem] mt-1.5 flex h-4 w-4 items-center justify-center rounded-full border-2 border-brand-400 bg-ink-900" />
                <p class="text-xs font-bold uppercase tracking-[0.16em] text-brand-300">
                  {slot.time}
                </p>
                <h3 class="mt-2 text-xl text-white">{slot.title}</h3>
                <p class="mt-2 leading-relaxed text-ink-200">{slot.body}</p>
              </li>
            ))
          }
        </ol>
      </div>
    </div>
  </section>

  <!-- FAQ -->
  <section class="container-page py-20 sm:py-24">
    <SectionHeading eyebrow="Questions" title="Before you enrol" />

    <div class="mx-auto mt-14 max-w-3xl space-y-3">
      {
        faqs.map((faq, index) => (
          <details
            class="group rounded-2xl border border-ink-100 bg-white px-6 shadow-card"
            open={index === 0}
          >
            <summary class="flex cursor-pointer list-none items-center justify-between gap-6 py-5 text-left text-base font-bold text-ink-900 [&::-webkit-details-marker]:hidden">
              {faq.q}
              <svg
                class="h-5 w-5 shrink-0 text-ink-400 motion-safe:transition-transform group-open:rotate-45"
                viewBox="0 0 20 20"
                fill="currentColor"
                aria-hidden="true"
              >
                <path d="M10 4a1 1 0 011 1v4h4a1 1 0 110 2h-4v4a1 1 0 11-2 0v-4H5a1 1 0 110-2h4V5a1 1 0 011-1z" />
              </svg>
            </summary>
            <p class="border-t border-ink-100 py-5 leading-relaxed text-ink-600">{faq.a}</p>
          </details>
        ))
      }
    </div>
  </section>

  <EnquiryCTA />
</Base>
