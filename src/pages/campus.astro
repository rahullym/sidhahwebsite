---
import Base from '../layouts/Base.astro';
import SectionHeading from '../components/SectionHeading.astro';
import EnquiryCTA from '../components/EnquiryCTA.astro';
import Photo from '../components/Photo.astro';
import { contact } from '../data/site';

const facilities = [
  {
    title: 'Teaching classrooms',
    body: 'Projector-equipped rooms sized for small batches, so every seat is close enough to the board and the faculty.',
    photo: 'facility-classroom',
    icon: 'classroom' as const,
  },
  {
    title: 'Computer lab',
    body: 'Systems set up for Hospital Information System practice, Tally ERP 9, Excel and healthcare data work.',
    photo: 'facility-lab',
    icon: 'records' as const,
  },
  {
    title: 'Practical & role-play area',
    body: 'Where front-desk simulations, grievance handling drills and mock audits are run before you face the real thing.',
    photo: 'facility-practical',
    icon: 'team' as const,
  },
  {
    title: 'Interview & discussion room',
    body: 'Mock HR panels, group discussions and presentation practice with faculty feedback on the spot.',
    photo: 'facility-interview',
    icon: 'interview' as const,
  },
];

---

<Base
  title="Campus"
  description="Visit the Sidhah Edutech campus in Kochi, Kerala — classrooms, computer lab and interview practice rooms, all under one roof."
>
  <section class="hex-pattern border-b border-ink-100 bg-brand-50/60">
    <div class="container-page py-16 sm:py-20">
      <p class="text-xs font-bold uppercase tracking-[0.18em] text-brand-700">Our campus</p>
      <h1 class="mt-3 max-w-3xl text-4xl leading-tight sm:text-5xl">
        One campus, in Kochi
      </h1>
      <p class="mt-5 max-w-2xl text-lg leading-relaxed text-ink-600">
        Everything we teach happens here. Classes, labs, interview practice and
        assessments all run from our campus in Kochi, Kerala.
      </p>

      <div class="mt-9 flex flex-col gap-3 sm:flex-row">
        <a
          href={contact.campus.mapsHref}
          target="_blank"
          rel="noopener noreferrer"
          class="inline-flex items-center justify-center gap-2 rounded-xl bg-brand-600 px-7 py-4 text-sm font-bold text-white shadow-lg shadow-brand-600/20 transition-colors hover:bg-brand-700"
        >
          <svg
            class="h-4.5 w-4.5"
            viewBox="0 0 24 24"
            fill="none"
            stroke="currentColor"
            stroke-width="2"
            aria-hidden="true"
          >
            <path
              d="M21 10c0 7-9 13-9 13s-9-6-9-13a9 9 0 0118 0z"
              stroke-linecap="round"
              stroke-linejoin="round"></path>
            <circle cx="12" cy="10" r="3"></circle>
          </svg>
          Open in Google Maps
        </a>
        <a
          href={contact.phoneHref}
          class="inline-flex items-center justify-center rounded-xl border border-ink-200 bg-white px-7 py-4 text-sm font-bold text-ink-900 transition-colors hover:border-brand-300 hover:text-brand-700"
        >
          Call {contact.phone}
        </a>
      </div>
    </div>
  </section>

  <section class="container-page py-16 sm:py-20">
    <div class="grid gap-8 lg:grid-cols-[1fr_1.3fr] lg:items-start">
      <div class="rounded-4xl border border-ink-100 bg-white p-8 shadow-card">
        <h2 class="text-2xl">{contact.campus.name}</h2>
        <address class="mt-5 not-italic leading-relaxed text-ink-600">
          {contact.campus.full}
        </address>

        <dl class="mt-8 space-y-3 border-t border-ink-100 pt-6">
          {
            contact.hours.map((slot) => (
              <div class="flex items-center justify-between gap-4">
                <dt class="text-sm text-ink-600">{slot.days}</dt>
                <dd class="text-sm font-bold text-ink-900">{slot.time}</dd>
              </div>
            ))
          }
        </dl>

        <div class="mt-8 space-y-2.5 border-t border-ink-100 pt-6 text-sm">
          <p>
            <a href={contact.phoneHref} class="font-bold text-brand-700 hover:text-brand-800">
              {contact.phone}
            </a>
          </p>
          <p>
            <a href={contact.emailHref} class="text-ink-600 hover:text-brand-700">
              {contact.email}
            </a>
          </p>
        </div>
      </div>

      <div class="overflow-hidden rounded-4xl border border-ink-100 shadow-card">
        <iframe
          title="Map showing Kochi, Kerala"
          src="https://maps.google.com/maps?q=Kochi%2C%20Kerala%2C%20India&t=&z=11&ie=UTF8&iwloc=&output=embed"
          class="h-[26rem] w-full border-0 lg:h-[32rem]"
          loading="lazy"
          referrerpolicy="no-referrer-when-downgrade"></iframe>
      </div>
    </div>
  </section>

  <section class="bg-ink-50/60 py-20 sm:py-24">
    <div class="container-page">
      <SectionHeading
        eyebrow="Facilities"
        title="What is on the floor"
        description="Nothing extravagant — just the rooms and equipment the programs actually need."
      />
      <div class="mt-14 grid gap-6 sm:grid-cols-2">
        {
          facilities.map((facility) => (
            <div class="overflow-hidden rounded-3xl border border-ink-100 bg-white shadow-card">
              <Photo
                name={facility.photo}
                alt={facility.title}
                ratio="aspect-16/9"
                sizes="(min-width: 640px) 34rem, 90vw"
                widths={[480, 768, 1100]}
                icon={facility.icon}
                label={facility.title}
              />
              <div class="p-7">
                <h3 class="text-xl">{facility.title}</h3>
                <p class="mt-3 leading-relaxed text-ink-600">{facility.body}</p>
              </div>
            </div>
          ))
        }
      </div>
    </div>
  </section>


  <EnquiryCTA
    title="Drop in and have a look"
    description="We are open Monday to Saturday. Message ahead and we will make sure a faculty member is free to show you around."
    message="Hi Sidhah, I'd like to visit the campus. When would be a good time?"
  />
</Base>
