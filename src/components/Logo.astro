---
interface Props {
  /** `light` renders the wordmark in white for dark backgrounds. */
  variant?: 'dark' | 'light';
  showTagline?: boolean;
  class?: string;
}

const { variant = 'dark', showTagline = true, class: className = '' } = Astro.props;

const wordmark = variant === 'light' ? 'text-white' : 'text-ink-900';
const taglineColor = variant === 'light' ? 'text-brand-200' : 'text-ink-400';
---

<span class={`inline-flex items-center gap-2.5 ${className}`}>
  <svg
    class="h-9 w-9 shrink-0"
    viewBox="0 0 40 40"
    fill="none"
    aria-hidden="true"
    xmlns="http://www.w3.org/2000/svg"
  >
    <circle cx="20" cy="20" r="20" fill="currentColor" class="text-brand-600" />
    <path
      d="M20 10.5v19M10.5 20h19"
      stroke="white"
      stroke-width="4.5"
      stroke-linecap="round"
    />
  </svg>
  <span class="flex flex-col leading-none">
    <span class={`text-[1.35rem] font-extrabold tracking-tight ${wordmark}`}>
      Sidhah
    </span>
    {
      showTagline && (
        <span class={`mt-1 text-[0.62rem] font-medium tracking-[0.14em] uppercase ${taglineColor}`}>
          Discover a new way
        </span>
      )
    }
  </span>
</span>
