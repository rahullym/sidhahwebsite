---
import { Image } from 'astro:assets';
import logo from '../assets/logos/sidhah-logo.png';

interface Props {
  /**
   * `light` knocks the mark out to solid white for the navy footer. The artwork
   * is a blue gradient on transparent, so it would otherwise disappear there.
   */
  variant?: 'dark' | 'light';
  class?: string;
}

const { variant = 'dark', class: className = '' } = Astro.props;
---

<Image
  src={logo}
  alt="Sidhah — Discover a new way"
  widths={[180, 360, 540]}
  sizes="(min-width: 640px) 11rem, 9rem"
  class:list={[
    /* No height here on purpose: two Tailwind height classes resolve by CSS
       order, not attribute order, so the caller owns sizing outright. */
    'w-auto object-contain',
    variant === 'light' && 'brightness-0 invert',
    className,
  ]}
  loading="eager"
  fetchpriority="high"
/>
