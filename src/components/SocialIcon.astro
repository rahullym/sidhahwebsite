---
/**
 * One outline glyph per social network, drawn in the same rounded-square family
 * so the icons sit together as a set instead of mixing solid brand marks.
 */
interface Props {
  name: 'instagram' | 'linkedin' | 'facebook';
  class?: string;
}

const { name, class: className = 'h-5 w-5' } = Astro.props;
---

<svg
  class={className}
  viewBox="0 0 24 24"
  fill="none"
  stroke="currentColor"
  stroke-width="1.8"
  stroke-linecap="round"
  stroke-linejoin="round"
  aria-hidden="true"
>
  {
    name === 'instagram' && (
      <>
        <rect x="3" y="3" width="18" height="18" rx="5" />
        <circle cx="12" cy="12" r="3.8" />
        <path d="M17 7h.01" />
      </>
    )
  }
  {
    name === 'linkedin' && (
      <>
        <rect x="3" y="3" width="18" height="18" rx="5" />
        <path d="M7.5 10.8V17" />
        <path d="M7.5 7.6h.01" />
        <path d="M11.6 17v-6.2m0 3.1a2.6 2.6 0 0 1 5.2 0V17" />
      </>
    )
  }
  {
    name === 'facebook' && (
      <>
        <rect x="3" y="3" width="18" height="18" rx="5" />
        <path d="M15.2 7.8h-1.4a2 2 0 0 0-2 2V18.6" />
        <path d="M9.4 12.6h4.8" />
      </>
    )
  }
</svg>
