---
import { contact, whatsappHref } from '../data/site';

interface Props {
  title?: string;
  description?: string;
  /** Prefills the WhatsApp message so enquiries arrive with context. */
  message?: string;
}

const {
  title = 'Come see the classroom before you decide',
  description = 'Walk into our Infopark campus, sit in on a session and meet the faculty. Message us on WhatsApp and we will hold a slot for you.',
  message = "Hi Sidhah, I'd like to book a campus visit for the hospital administration program.",
} = Astro.props;
---

<section class="container-page">
  <div
    class="hex-pattern relative overflow-hidden rounded-4xl bg-ink-900 px-7 py-14 text-center sm:px-12 sm:py-16"
  >
    <div
      class="pointer-events-none absolute -right-16 -top-20 h-64 w-64 rounded-full bg-brand-600/25 blur-3xl"
      aria-hidden="true"
    >
    </div>
    <div
      class="pointer-events-none absolute -bottom-24 -left-16 h-64 w-64 rounded-full bg-brand-500/15 blur-3xl"
      aria-hidden="true"
    >
    </div>

    <div class="relative mx-auto max-w-2xl">
      <h2 class="text-3xl text-white sm:text-4xl">{title}</h2>
      <p class="mt-4 text-base leading-relaxed text-ink-200 sm:text-lg">{description}</p>

      <div class="mt-9 flex flex-col gap-3 sm:flex-row sm:justify-center">
        <a
          href={whatsappHref(message)}
          target="_blank"
          rel="noopener noreferrer"
          class="inline-flex items-center justify-center gap-2.5 rounded-xl bg-[#25D366] px-6 py-4 text-sm font-bold text-white transition-transform hover:scale-[1.02]"
        >
          <svg class="h-5 w-5" viewBox="0 0 24 24" fill="currentColor" aria-hidden="true">
            <path
              d="M12.04 2C6.58 2 2.13 6.45 2.13 11.91c0 1.75.46 3.45 1.32 4.95L2 22l5.25-1.38a9.86 9.86 0 0 0 4.79 1.22h.01c5.46 0 9.91-4.45 9.91-9.91S17.5 2 12.04 2zm5.43 12.38c-.3-.15-1.75-.86-2.02-.96-.27-.1-.47-.15-.67.15-.2.3-.77.96-.94 1.16-.17.2-.35.22-.64.08-.3-.15-1.25-.46-2.38-1.47-.88-.78-1.47-1.75-1.64-2.05-.17-.3-.02-.46.13-.6.13-.13.3-.35.45-.52.15-.17.2-.3.3-.5.1-.2.05-.37-.02-.52-.08-.15-.67-1.6-.92-2.2-.24-.58-.49-.5-.67-.51h-.57c-.2 0-.52.07-.79.37-.27.3-1.04 1.01-1.04 2.47s1.06 2.86 1.21 3.06c.15.2 2.1 3.2 5.08 4.49.71.3 1.26.49 1.69.63.71.23 1.36.19 1.87.12.57-.09 1.75-.72 2-1.41.25-.7.25-1.29.17-1.41-.07-.13-.27-.2-.57-.35z"
            ></path>
          </svg>
          Chat on WhatsApp
        </a>
        <a
          href={contact.phoneHref}
          class="inline-flex items-center justify-center gap-2.5 rounded-xl bg-white px-6 py-4 text-sm font-bold text-ink-900 transition-colors hover:bg-ink-100"
        >
          <svg
            class="h-5 w-5"
            viewBox="0 0 24 24"
            fill="none"
            stroke="currentColor"
            stroke-width="2"
            aria-hidden="true"
          >
            <path
              d="M22 16.92v3a2 2 0 0 1-2.18 2 19.79 19.79 0 0 1-8.63-3.07 19.5 19.5 0 0 1-6-6A19.79 19.79 0 0 1 2.12 4.18 2 2 0 0 1 4.11 2h3a2 2 0 0 1 2 1.72c.13.96.36 1.9.7 2.81a2 2 0 0 1-.45 2.11L8.09 9.91a16 16 0 0 0 6 6l1.27-1.27a2 2 0 0 1 2.11-.45c.9.34 1.85.57 2.81.7A2 2 0 0 1 22 16.92z"
              stroke-linecap="round"
              stroke-linejoin="round"></path>
          </svg>
          {contact.phone}
        </a>
      </div>

      <p class="mt-6 text-sm text-ink-400">
        {contact.campus.line1}, {contact.campus.city} · Mon–Sat, 9:30 AM – 6:00 PM
      </p>
    </div>
  </div>
</section>
