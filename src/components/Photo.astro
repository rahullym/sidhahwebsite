---
import { Image } from 'astro:assets';
import { photo } from '../lib/images';

type Icon = 'classroom' | 'campus' | 'hospital' | 'team' | 'graduation' | 'records' | 'interview';

interface Props {
  /** Filename (no extension) in src/assets/photos/ */
  name: string;
  alt: string;
  /** Aspect ratio utility, e.g. "aspect-4/5". Omit when the parent sets height. */
  ratio?: string;
  class?: string;
  sizes?: string;
  widths?: number[];
  /** Line art shown in the placeholder until the real photo is supplied. */
  icon?: Icon;
  /** Short caption on the placeholder so it reads as intentional, not broken. */
  label?: string;
  /**
   * `dark` for slots with text reversed over them. Everything else uses the
   * light treatment — a page of saturated panels reads as heavy, not designed.
   */
  tone?: 'light' | 'dark';
  /**
   * Forces a specific light tint (0–3). Set this on slots that sit side by side
   * — hashing alone can hand neighbours the same colour.
   */
  tint?: number;
  /** Skips lazy-loading — use for the one image above the fold. */
  priority?: boolean;
}

const {
  name,
  alt,
  ratio = '',
  class: className = '',
  sizes = '(min-width: 1024px) 40rem, 100vw',
  widths = [480, 768, 1200, 1600],
  icon = 'campus',
  label,
  tone = 'light',
  tint,
  priority = false,
} = Astro.props;

const source = photo(name);

/**
 * Placeholders sit side by side in the campus band, so a single treatment would
 * read as one flat slab. Pick from the slot name — deterministic, so a given
 * slot looks the same between builds.
 */
const lightTones = [
  { bg: 'bg-brand-50', art: 'text-brand-300', text: 'text-brand-700/70' },
  { bg: 'bg-brand-100', art: 'text-brand-400', text: 'text-brand-700/70' },
  { bg: 'bg-ink-100', art: 'text-ink-300', text: 'text-ink-400' },
  { bg: 'bg-gold-100', art: 'text-gold-400', text: 'text-gold-700/80' },
];

const hash = [...name].reduce((total, char) => total + char.charCodeAt(0), 0);
const light = lightTones[(tint ?? hash) % lightTones.length]!;

const surface =
  tone === 'dark' ? 'bg-gradient-to-br from-ink-800 via-ink-900 to-brand-900' : light.bg;
const artColor = tone === 'dark' ? 'text-white/30' : light.art;
const labelColor = tone === 'dark' ? 'text-white/45' : light.text;

const icons: Record<Icon, string> = {
  classroom: 'M4 5h16a1 1 0 011 1v10a1 1 0 01-1 1H4a1 1 0 01-1-1V6a1 1 0 011-1zm4 4h8m-8 4h5m-1 4l-2 4m4-4l2 4',
  campus: 'M3 21h18M5 21V8l7-4 7 4v13M9 21v-5h6v5M9 11h2m2 0h2',
  hospital: 'M3 21h18M5 21V8l7-4 7 4v13M10 12h4M12 10v4M10 21v-4h4v4',
  team: 'M17 20h5v-2a3 3 0 00-5.36-1.86M17 20H7m10 0v-2c0-.66-.13-1.3-.36-1.86M7 20H2v-2a3 3 0 015.36-1.86M7 20v-2c0-.66.13-1.3.36-1.86m0 0a5 5 0 019.28 0M15 7a3 3 0 11-6 0 3 3 0 016 0z',
  graduation: 'M12 14l9-5-9-5-9 5 9 5zm0 0v7m-6-8.4v4.9A7 7 0 0012 21a7 7 0 006-3.5v-4.9',
  records: 'M8 3h8a2 2 0 012 2v14a2 2 0 01-2 2H8a2 2 0 01-2-2V5a2 2 0 012-2zm2 5h4m-4 4h4m-4 4h2',
  interview: 'M8 10h8M8 14h5M21 12a8 8 0 01-8 8H7l-4 3v-7a8 8 0 018-8h2a8 8 0 018 8z',
};
---

<div class={`relative overflow-hidden ${ratio} ${className}`}>
  {
    source ? (
      <Image
        src={source}
        alt={alt}
        widths={widths}
        sizes={sizes}
        class="h-full w-full object-cover"
        loading={priority ? 'eager' : 'lazy'}
        fetchpriority={priority ? 'high' : 'auto'}
      />
    ) : (
      /* Designed placeholder — reads as a graphic panel, not a broken image.
         Replaced automatically once src/assets/photos/<name> exists. */
      <div
        class={`flex h-full w-full flex-col items-center justify-center ${surface}`}
        role="img"
        aria-label={alt}
      >
        <div class="hex-pattern absolute inset-0 opacity-60" aria-hidden="true" />
        <svg
          class={`relative h-10 w-10 ${artColor}`}
          viewBox="0 0 24 24"
          fill="none"
          stroke="currentColor"
          stroke-width="1.25"
          stroke-linecap="round"
          stroke-linejoin="round"
          aria-hidden="true"
        >
          <path d={icons[icon]} />
        </svg>
        {label && (
          <p
            class={`relative mt-3 px-4 text-center text-[0.65rem] font-bold uppercase tracking-[0.18em] ${labelColor}`}
          >
            {label}
          </p>
        )}
      </div>
    )
  }
</div>
