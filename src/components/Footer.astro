---
import Logo from './Logo.astro';
import SocialIcon from './SocialIcon.astro';
import { nav, contact, site, socials } from '../data/site';
import { courses } from '../data/courses';
import { href } from '../lib/url';

const year = new Date().getFullYear();
---

<footer class="mt-24 bg-ink-950 text-ink-200">
  <div class="container-page py-16">
    <div class="grid gap-12 lg:grid-cols-[1.4fr_1fr_1fr_1.2fr]">
      <div>
        <Logo variant="light" class="h-12" />
        <p class="mt-5 max-w-xs text-sm leading-relaxed text-ink-200/80">
          Classroom-only hospital administration training in Kochi, Kerala.
          Small in-person batches, real hospital exposure, placement support.
        </p>
        <ul class="mt-6 flex items-center gap-3">
          {
            socials.map((social) => (
              <li>
                <a
                  href={social.href}
                  target="_blank"
                  rel="noopener noreferrer"
                  aria-label={`Sidhah Edutech on ${social.label}`}
                  class="inline-flex h-10 w-10 items-center justify-center rounded-xl border border-white/15 text-ink-200/80 transition-colors hover:border-white/40 hover:text-white"
                >
                  <SocialIcon name={social.icon} />
                </a>
              </li>
            ))
          }
        </ul>
      </div>

      <div>
        <h2 class="text-sm font-bold uppercase tracking-wider text-white">Explore</h2>
        <ul class="mt-5 space-y-3 text-sm">
          {
            nav.map((item) => (
              <li>
                <a href={href(item.href)} class="text-ink-200/80 transition-colors hover:text-white">
                  {item.label}
                </a>
              </li>
            ))
          }
        </ul>
      </div>

      <div>
        <h2 class="text-sm font-bold uppercase tracking-wider text-white">Programs</h2>
        <ul class="mt-5 space-y-3 text-sm">
          {
            courses.map((course) => (
              <li>
                <a
                  href={href(`/courses/${course.slug}/`)}
                  class="text-ink-200/80 transition-colors hover:text-white"
                >
                  {course.title}
                  <span class="block text-xs text-ink-300">{course.duration}</span>
                </a>
              </li>
            ))
          }
        </ul>
      </div>

      <div>
        <h2 class="text-sm font-bold uppercase tracking-wider text-white">Visit us</h2>
        <address class="mt-5 space-y-3 text-sm not-italic text-ink-200/80">
          <p>{contact.campus.full}</p>
          <p>
            <a href={contact.phoneHref} class="font-semibold text-white hover:text-brand-200">
              {contact.phone}
            </a>
          </p>
          <p>
            <a href={contact.emailHref} class="hover:text-white">{contact.email}</a>
          </p>
        </address>
      </div>
    </div>

    <div
      class="mt-14 flex flex-col gap-3 border-t border-white/10 pt-8 text-xs text-ink-300 sm:flex-row sm:items-center sm:justify-between"
    >
      <p>© {year} {site.legalName}. All rights reserved.</p>
      <p>All programs are conducted in person in Kochi.</p>
    </div>
  </div>
</footer>
