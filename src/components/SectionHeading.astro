---
interface Props {
  eyebrow?: string;
  title: string;
  description?: string;
  align?: 'left' | 'center';
  class?: string;
}

const { eyebrow, title, description, align = 'center', class: className = '' } = Astro.props;

const alignment = align === 'center' ? 'mx-auto text-center' : 'text-left';
---

<div class={`max-w-2xl ${alignment} ${className}`} data-reveal>
  {
    eyebrow && (
      <p
        class:list={[
          'accent-rule text-xs font-bold uppercase tracking-[0.18em] text-brand-600',
          align === 'center' && 'accent-rule-center',
        ]}
      >
        {eyebrow}
      </p>
    )
  }
  <h2 class="mt-5 text-3xl leading-[1.12] sm:text-4xl">{title}</h2>
  {
    description && (
      <p class="mt-4 text-base leading-relaxed text-ink-600 sm:text-lg">{description}</p>
    )
  }
</div>
